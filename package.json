{
  "name": "clippy-for-claude",
  "version": "0.1.0",
  "description": "A Clippy for your Mac that watches Claude Code and Codex sessions and lets you answer them without hunting through terminal tabs",
  "author": "AI Socratic (https://aisocratic.org)",
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "openai-codex",
    "electron",
    "hooks",
    "macos",
    "pixel-art"
  ],
  "license": "MIT",
  "main": "src/main.js",
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=18.13"
  },
  "scripts": {
    "start": "node scripts/make-buddies.js --if-missing && electron .",
    "dev": "node scripts/make-buddies.js --if-missing && node scripts/dev.js",
    "dev:once": "node scripts/make-buddies.js --if-missing && CLIPPY_DEV=1 electron .",
    "sandbox": "node scripts/demo-web.js --open /gallery",
    "sandbox:app": "node scripts/make-buddies.js --if-missing && CLIPPY_SANDBOX=1 electron .",
    "test": "node --test test/*.test.js",
    "test:watch": "node --test --watch test/*.test.js",
    "check": "find bin demo scripts src test -name '*.js' -exec node --check {} \\; && node --test test/*.test.js",
    "make-buddies": "node scripts/make-buddies.js",
    "package": "node scripts/package-app.js",
    "package:release": "node scripts/package-app.js --require-release-signing",
    "add-sprite-pack": "node scripts/add-sprite-pack.js",
    "mock-session": "node scripts/mock-session.js",
    "demo:web": "node scripts/demo-web.js",
    "hooks:install": "node bin/clippy-hooks.js install",
    "hooks:uninstall": "node bin/clippy-hooks.js uninstall",
    "hooks:status": "node bin/clippy-hooks.js status",
    "website": "node website/build.js && open website/index.html"
  },
  "devDependencies": {
    "electron": "^33.0.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0"
  }
}
