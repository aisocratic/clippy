{
  "name": "@aisocratic/clippy-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "doctor": "expo-doctor",
    "build:ios": "npx eas-cli@latest build --platform ios --profile production",
    "build:ios:preview": "npx eas-cli@latest build --platform ios --profile preview",
    "submit:ios": "npx eas-cli@latest submit --platform ios --profile production --latest",
    "testflight": "npm run build:ios && npm run submit:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "expo": "~54.0.20",
    "expo-constants": "~18.0.10",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.7",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.17",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "expo-doctor": "^1.20.1",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.13",
    "typescript": "~5.9.2"
  }
}
