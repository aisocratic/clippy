{
  "expo": {
    "name": "Clippy",
    "slug": "clippy-mobile",
    "owner": "ai-socratic",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "clippy",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "primaryColor": "#F7F1E7",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.aisocratic.clippy.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "development"
      }
    },
    "android": {
      "package": "dev.aisocratic.clippy.mobile",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F1E7"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#F7F1E7",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#F2C94C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7bb962c4-fc7b-424b-9616-9e3be693fa00"
      }
    }
  }
}
